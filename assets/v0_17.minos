syntax = 0.17;



resource File {
    policy {
        allow = ["read", "copy", "write", "trash"];

        rule {
            actor.type = Root;
        }

        rule {
            resource.owner = actor.id;
            actor.status != Banned;
        }

        rule {
            actor.groups ?= [
                "sudo",
                "sysadmin",
            ];
            actor.status != Banned;
        }
    }

    policy {
        allow = ["read"];

        rule {
            actor.type = Guest;
        }
    }

    policy {
        allow = ["create"];

        rule {
            actor.type != Guest;
        }
    }

    policy {
        allow = ["delete"];

        rule {
            resource.owner = actor.id;
            actor.status != Banned;
            actor.roles !*= [
                "minor",
                "supervised"
            ];
        }

        rule {
            actor.type = Root;
        }
    }

}
